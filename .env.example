# ==============================================================================
# AGENTFLOW AI — Master Environment Configuration Template
# Copy this file to .env or service-specific .env files before running.
# NEVER commit .env with real credentials to source control.
# ==============================================================================

# Node / API Configuration
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000
APP_BASE_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Database & Cache
MONGODB_URI=mongodb://localhost:27017/agentflow
REDIS_URL=redis://localhost:6379

# Authentication & Security
JWT_SECRET=replace_with_a_secure_random_64_char_hex_string_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace_with_another_secure_random_64_char_hex_string
JWT_REFRESH_EXPIRES_IN=30d
ENCRYPTION_KEY=replace_with_32_byte_hex_key_for_encrypting_integrations

# AI Service Configuration
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_PORT=8000
OPENAI_API_KEY=your_openai_api_key_here
DEFAULT_AI_MODEL=gpt-4o-mini
AI_EXECUTION_TIMEOUT_SECONDS=120

# Human Approval & Safety
ENFORCE_APPROVAL_FOR_MUTATIONS=true
SSRF_PROTECTION_ENABLED=true

# Email / SMTP (Optional - mock notifications enabled when unconfigured)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="AgentFlow AI <no-reply@agentflow.ai>"

# Stripe Billing (Optional - setup mode displayed when unconfigured)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=price_starter_dummy
STRIPE_PRICE_PRO=price_pro_dummy
STRIPE_PRICE_ENTERPRISE=price_enterprise_dummy

# File Storage
UPLOAD_MAX_FILE_SIZE_BYTES=15728640
UPLOAD_DIR=./uploads

# Platform Admin Seed Credentials
PLATFORM_ADMIN_EMAIL=admin@agentflow.ai
PLATFORM_ADMIN_PASSWORD=AdminSecurePassword123!
