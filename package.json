{
  "name": "agentflow-ai-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "AGENTFLOW AI — Autonomous AI Workforce & Multi-Agent SaaS Platform",
  "workspaces": [
    "packages/*",
    "apps/api",
    "apps/web"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "dev:api": "npm run dev --workspace=apps/api",
    "dev:web": "npm run dev --workspace=apps/web",
    "build:shared": "npm run build --workspace=packages/shared",
    "build:api": "npm run build --workspace=apps/api",
    "build:web": "npm run build --workspace=apps/web"
  },
  "keywords": [
    "ai-agents",
    "multi-agent",
    "langgraph",
    "saas",
    "workflow-automation",
    "human-in-the-loop"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/danishalipny-pixel/AgentFlow-Ai-sas.git"
  },
  "author": "Danish Rashid <danish.ali.pny@gmail.com>",
  "license": "MIT"
}
